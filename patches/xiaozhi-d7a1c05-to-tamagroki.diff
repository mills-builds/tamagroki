+// SpiLcdDisplay that replaces xiaozhi's chat UI with the full-screen Tamagroki face.
+#pragma once
+#include "lcd_display.h"
+#include "grok_face.h"
+#include <string>
+
+class GrokFaceDisplay : public SpiLcdDisplay {
+public:
+    using SpiLcdDisplay::SpiLcdDisplay;
+    ~GrokFaceDisplay() override;
+
+    void SetupUI() override;
+    void SetEmotion(const char* emotion) override;
+    void SetChatMessage(const char* role, const char* content) override;
+    void ClearChatMessages() override;
+    void SetStatus(const char* status) override;
+    void ShowNotification(const char* notification, int duration_ms = 3000) override;
+    void ShowNotification(const std::string& notification, int duration_ms = 3000) override;
+    void SetPowerSaveMode(bool on) override;
+    void UpdateStatusBar(bool update_all = false) override {}
+
+    // Simulates a "pick-up" or other external nudge: wakes the face from sleep.
+    void Nudge();
+
+private:
+    static void TimerCb(lv_timer_t* t);
+    void OnTick();
+
+    GrokFace face_;
+    lv_timer_t* timer_ = nullptr;
+    bool power_save_ = false;
+    bool thinking_hint_ = false;   // set by llm emotion "thinking", cleared on state change
+    int last_device_state_ = -1;
+    uint32_t notification_until_ = 0;
+    std::string system_caption_;
+};
diff -ruN '--exclude=out' a/main/tamagroki/qmi8658_pickup.cc b/main/tamagroki/qmi8658_pickup.cc
--- a/main/tamagroki/qmi8658_pickup.cc	1969-12-31 18:00:00.000000000 -0600
+++ b/main/tamagroki/qmi8658_pickup.cc	2026-10-15 16:16:08.159756022 -0500
@@ -0,0 +1,71 @@
+#include "qmi8658_pickup.h"
+#include <esp_log.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <math.h>
+
+#define TAG "Qmi8658Pickup"
+
+// Registers (QMI8658 datasheet rev 0.9)
+static constexpr uint8_t REG_WHO_AM_I = 0x00;  // 0x05
+static constexpr uint8_t REG_CTRL1 = 0x02;     // bit6 ADDR_AI auto increment
+static constexpr uint8_t REG_CTRL2 = 0x03;     // accel FS[6:4], ODR[3:0]
+static constexpr uint8_t REG_CTRL7 = 0x08;     // bit0 aEN
+static constexpr uint8_t REG_AX_L = 0x35;
+
+Qmi8658Pickup::Qmi8658Pickup(i2c_master_bus_handle_t bus, uint8_t addr) : I2cDevice(bus, addr) {
+    uint8_t who = ReadReg(REG_WHO_AM_I);
+    if (who != 0x05) {
+        ESP_LOGW(TAG, "QMI8658 not found (WHO_AM_I=0x%02X)", who);
+        return;
+    }
+    WriteReg(REG_CTRL1, 0x40);  // address auto-increment, little endian
+    WriteReg(REG_CTRL2, 0x16);  // +-4 g (FS=001), ODR ~ 62.5 Hz (0110)
+    WriteReg(REG_CTRL7, 0x01);  // accel only
+    ok_ = true;
+    ESP_LOGI(TAG, "QMI8658 ready");
+}
+
+bool Qmi8658Pickup::ReadAccelMg(float& x, float& y, float& z) {
+    uint8_t b[6];
+    ReadRegs(REG_AX_L, b, 6);
+    auto s = [&](int i) { return (int16_t)(b[i] | (b[i + 1] << 8)); };
+    const float lsb_per_g = 8192.0f;  // +-4 g
+    x = s(0) * 1000.0f / lsb_per_g;
+    y = s(2) * 1000.0f / lsb_per_g;
+    z = s(4) * 1000.0f / lsb_per_g;
+    return true;
+}
+
+void Qmi8658Pickup::Start(std::function<void()> on_pickup, int threshold_mg) {
+    if (!ok_) return;
+    on_pickup_ = std::move(on_pickup);
+    threshold_mg_ = threshold_mg;
+    xTaskCreate(TaskEntry, "imu_pickup", 3072, this, 2, nullptr);
+}
+
+void Qmi8658Pickup::TaskEntry(void* arg) { static_cast<Qmi8658Pickup*>(arg)->Run(); }
+
+void Qmi8658Pickup::Run() {
+    float rx = 0, ry = 0, rz = 0;  // slow "resting" gravity estimate
+    bool init = false;
+    int hits = 0;
+    TickType_t cooldown_until = 0;
+    while (true) {
+        vTaskDelay(pdMS_TO_TICKS(50));
+        float x, y, z;
+        if (!ReadAccelMg(x, y, z)) continue;
+        if (!init) { rx = x; ry = y; rz = z; init = true; continue; }
+        float dx = x - rx, dy = y - ry, dz = z - rz;
+        float dev = sqrtf(dx * dx + dy * dy + dz * dz);
+        // resting estimate follows slowly (~2 s time constant)
+        rx += 0.025f * dx; ry += 0.025f * dy; rz += 0.025f * dz;
+        hits = dev > threshold_mg_ ? hits + 1 : 0;
+        if (hits >= 3 && xTaskGetTickCount() > cooldown_until) {  // ~150 ms of motion
+            hits = 0;
+            cooldown_until = xTaskGetTickCount() + pdMS_TO_TICKS(8000);
+            ESP_LOGI(TAG, "pick-up detected (dev=%.0f mg)", dev);
+            if (on_pickup_) on_pickup_();
+        }
+    }
+}
diff -ruN '--exclude=out' a/main/tamagroki/qmi8658_pickup.h b/main/tamagroki/qmi8658_pickup.h
--- a/main/tamagroki/qmi8658_pickup.h	1969-12-31 18:00:00.000000000 -0600
+++ b/main/tamagroki/qmi8658_pickup.h	2026-10-15 16:16:08.159756022 -0500
@@ -0,0 +1,20 @@
+// Minimal QMI8658 accelerometer poller: fires a callback when the cube is picked up
+// (sustained deviation of |a| from 1 g, or a big orientation change).
+#pragma once
+#include "i2c_device.h"
+#include <functional>
+
+class Qmi8658Pickup : public I2cDevice {
+public:
+    Qmi8658Pickup(i2c_master_bus_handle_t bus, uint8_t addr = 0x6B);
+    bool ok() const { return ok_; }
+    void Start(std::function<void()> on_pickup, int threshold_mg);
+
+private:
+    static void TaskEntry(void* arg);
+    void Run();
+    bool ReadAccelMg(float& x, float& y, float& z);
+    bool ok_ = false;
+    int threshold_mg_ = 350;
+    std::function<void()> on_pickup_;
+};
diff -ruN '--exclude=out' a/main/tamagroki/tamagroki.h b/main/tamagroki/tamagroki.h
--- a/main/tamagroki/tamagroki.h	1969-12-31 18:00:00.000000000 -0600
+++ b/main/tamagroki/tamagroki.h	2026-10-15 16:16:08.159756022 -0500
@@ -0,0 +1,12 @@
+// Tamagroki cube glue shared between the face, audio path and board.
+#pragma once
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace tamagroki {
+// Loudness (0..1) of the PCM currently being sent to the speaker.
+// Written by AudioService's output task, read by the face timer.
+extern std::atomic<float> g_playback_level;
+void ReportPlaybackPcm(const int16_t* pcm, size_t samples);
+}  // namespace tamagroki
diff -ruN '--exclude=out' a/main/tamagroki/tamagroki_audio.cc b/main/tamagroki/tamagroki_audio.cc
--- a/main/tamagroki/tamagroki_audio.cc	1969-12-31 18:00:00.000000000 -0600
+++ b/main/tamagroki/tamagroki_audio.cc	2026-10-15 16:16:08.159756022 -0500
@@ -0,0 +1,19 @@
+#include <stddef.h>
+#include <stdint.h>
+#include <math.h>
+#include "tamagroki.h"
+
+namespace tamagroki {
+std::atomic<float> g_playback_level{0.0f};
+
+void ReportPlaybackPcm(const int16_t* pcm, size_t samples) {
+    if (samples == 0) return;
+    double acc = 0;
+    for (size_t i = 0; i < samples; i++) acc += (double)pcm[i] * pcm[i];
+    float rms = sqrtf((float)(acc / samples)) / 32768.0f;
+    // map ~-40 dBFS..-6 dBFS onto 0..1
+    float db = 20.0f * log10f(rms + 1e-6f);
+    float lvl = (db + 40.0f) / 34.0f;
+    g_playback_level.store(lvl < 0 ? 0 : (lvl > 1 ? 1 : lvl), std::memory_order_relaxed);
+}
+}  // namespace tamagroki
