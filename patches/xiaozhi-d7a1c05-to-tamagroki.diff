diff -ruN '--exclude=out' a/main/tamagroki/grok_face.cc b/main/tamagroki/grok_face.cc
--- a/main/tamagroki/grok_face.cc	1969-12-31 18:00:00.000000000 -0600
+++ b/main/tamagroki/grok_face.cc	2026-10-15 16:16:08.155756022 -0500
@@ -0,0 +1,220 @@
+#include "grok_face.h"
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+static inline float lerp(float a, float b, float t) { return a + (b - a) * t; }
+static inline float clampf(float v, float lo, float hi) { return v < lo ? lo : (v > hi ? hi : v); }
+// exponential smoothing that is frame-rate independent
+static inline float approach(float cur, float target, float rate_per_s, float dt) {
+    float k = 1.0f - expf(-rate_per_s * dt);
+    return cur + (target - cur) * k;
+}
+
+const char* FaceStateName(FaceState s) {
+    switch (s) {
+        case FaceState::kIdle: return "idle";
+        case FaceState::kListening: return "listening";
+        case FaceState::kThinking: return "thinking";
+        case FaceState::kSpeaking: return "speaking";
+        case FaceState::kSleep: return "sleep";
+        case FaceState::kBusy: return "busy";
+    }
+    return "?";
+}
+
+float GrokFace::Rand01() {
+    rng_ = rng_ * 1664525u + 1013904223u;
+    return (rng_ >> 8) / 16777216.0f;
+}
+
+void GrokFace::Create(lv_obj_t* parent, int width, int height, const FaceConfig& cfg) {
+    cfg_ = cfg;
+    w_ = width;
+    h_ = height;
+    root_ = lv_obj_create(parent);
+    lv_obj_remove_style_all(root_);
+    lv_obj_set_size(root_, width, height);
+    lv_obj_set_pos(root_, 0, 0);
+    lv_obj_set_style_bg_opa(root_, LV_OPA_COVER, 0);
+    lv_obj_set_style_bg_color(root_, lv_color_hex(cfg_.bg_color), 0);
+    lv_obj_remove_flag(root_, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(root_, LV_OBJ_FLAG_CLICKABLE);
+
+    for (int i = 0; i < 2; i++) {
+        eyes_[i] = lv_line_create(root_);
+        lv_obj_remove_flag(eyes_[i], LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_set_style_line_color(eyes_[i], lv_color_hex(cfg_.eye_color), 0);
+        lv_obj_set_style_line_rounded(eyes_[i], true, 0);
+        lv_obj_set_style_line_width(eyes_[i], cfg_.eye_width, 0);
+        lv_obj_set_pos(eyes_[i], 0, 0);
+        lv_obj_set_size(eyes_[i], width, height);
+    }
+
+    zzz_ = lv_label_create(root_);
+    lv_label_set_text(zzz_, "z z z");
+    lv_obj_set_style_text_color(zzz_, lv_color_hex(cfg_.eye_color), 0);
+    lv_obj_set_style_text_opa(zzz_, LV_OPA_70, 0);
+#if LV_FONT_MONTSERRAT_24
+    lv_obj_set_style_text_font(zzz_, &lv_font_montserrat_24, 0);
+#endif
+    lv_obj_add_flag(zzz_, LV_OBJ_FLAG_HIDDEN);
+
+    caption_ = lv_label_create(root_);
+    lv_obj_set_width(caption_, width * 70 / 100);
+    lv_label_set_long_mode(caption_, LV_LABEL_LONG_WRAP);
+    lv_obj_set_style_text_align(caption_, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_style_text_color(caption_, lv_color_hex(0x1A1033), 0);
+#if LV_FONT_MONTSERRAT_24
+    lv_obj_set_style_text_font(caption_, &lv_font_montserrat_24, 0);
+#endif
+    lv_obj_align(caption_, LV_ALIGN_BOTTOM_MID, 0, -height / 12);
+    lv_obj_add_flag(caption_, LV_OBJ_FLAG_HIDDEN);
+
+    Tick(0);
+}
+
+void GrokFace::SetBackground(uint32_t rgb) {
+    cfg_.bg_color = rgb;
+    if (root_) lv_obj_set_style_bg_color(root_, lv_color_hex(rgb), 0);
+}
+
+void GrokFace::SetCaption(const char* text) {
+    if (!caption_) return;
+    if (text == nullptr || text[0] == '\0') {
+        lv_obj_add_flag(caption_, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_label_set_text(caption_, text);
+        lv_obj_remove_flag(caption_, LV_OBJ_FLAG_HIDDEN);
+    }
+}
+
+void GrokFace::SetState(FaceState s, uint32_t now_ms) {
+    if (s == state_) return;
+    state_ = s;
+    state_since_ = now_ms;
+    if (s == FaceState::kListening) {
+        // a quick "oh!" blink when we start listening
+        blink_start_ = now_ms;
+        double_blink_ = false;
+    }
+}
+
+void GrokFace::ApplyEye(int idx, const EyePose& p) {
+    float base_x = w_ / 2.0f + (idx == 0 ? -1 : 1) * cfg_.eye_spacing / 2.0f;
+    float base_y = h_ / 2.0f + cfg_.center_y_offset;
+    float cx = base_x + p.dx, cy = base_y + p.dy;
+    float a = p.angle * (float)M_PI / 180.0f;
+    // direction of the pill's long axis (vertical rotated by angle, top leans right for +)
+    float ux = sinf(a), uy = -cosf(a);
+    float hl = p.length / 2.0f;
+    pts_[idx][0].x = (lv_value_precise_t)(cx + ux * hl);
+    pts_[idx][0].y = (lv_value_precise_t)(cy + uy * hl);
+    pts_[idx][1].x = (lv_value_precise_t)(cx - ux * hl);
+    pts_[idx][1].y = (lv_value_precise_t)(cy - uy * hl);
+    lv_line_set_points(eyes_[idx], pts_[idx], 2);
+    lv_obj_set_style_line_width(eyes_[idx], (int32_t)(p.width + 0.5f), 0);
+}
+
+void GrokFace::Tick(uint32_t now) {
+    float dt = (now - last_tick_) / 1000.0f;
+    if (dt < 0 || dt > 0.5f) dt = 0.033f;
+    last_tick_ = now;
+    float t = now / 1000.0f;
+    float since = (now - state_since_) / 1000.0f;
+
+    bool sleeping = state_ == FaceState::kSleep;
+    bool thinking = state_ == FaceState::kThinking || state_ == FaceState::kBusy;
+    sleep_ = approach(sleep_, sleeping ? 1.f : 0.f, sleeping ? 2.5f : 8.f, dt);
+    perk_ = approach(perk_, state_ == FaceState::kListening ? 1.f : 0.f, 10.f, dt);
+    think_ = approach(think_, thinking ? 1.f : 0.f, 6.f, dt);
+    float lvl_target = state_ == FaceState::kSpeaking ? audio_level_target_ : 0.f;
+    audio_level_ = approach(audio_level_, lvl_target, lvl_target > audio_level_ ? 30.f : 12.f, dt);
+
+    // ---- blink scheduling (idle, listening, speaking) ----
+    if (!sleeping && !thinking && now >= next_blink_) {
+        blink_start_ = now;
+        double_blink_ = Rand01() < 0.2f;
+        next_blink_ = now + 2500 + (uint32_t)(Rand01() * 4000);
+    }
+    float blink = 0;  // 0 open .. 1 closed
+    {
+        float bt = (now - blink_start_) / 1000.0f;
+        const float dur = 0.16f;
+        if (bt >= 0 && bt < dur) blink = sinf(bt / dur * (float)M_PI);
+        else if (double_blink_ && bt >= dur + 0.08f && bt < 2 * dur + 0.08f)
+            blink = sinf((bt - dur - 0.08f) / dur * (float)M_PI);
+    }
+
+    // ---- glances (idle only) ----
+    if (state_ == FaceState::kIdle && now >= next_glance_) {
+        float r = Rand01();
+        if (r < 0.35f) { glance_target_x_ = 0; glance_target_y_ = 0; }
+        else {
+            glance_target_x_ = (Rand01() * 2 - 1) * 40.f;
+            glance_target_y_ = (Rand01() * 2 - 1) * 18.f;
+        }
+        next_glance_ = now + 1800 + (uint32_t)(Rand01() * 3500);
+    } else if (state_ != FaceState::kIdle) {
+        glance_target_x_ = 0; glance_target_y_ = 0;
+    }
+    glance_x_ = approach(glance_x_, glance_target_x_, 9.f, dt);
+    glance_y_ = approach(glance_y_, glance_target_y_, 9.f, dt);
+
+    for (int i = 0; i < 2; i++) {
+        float side = i == 0 ? -1.f : 1.f;
+        EyePose p;
+        p.dx = glance_x_;
+        p.dy = glance_y_ + sinf(t * 1.6f) * 3.f;  // breathing
+        p.length = (float)cfg_.eye_length;
+        p.width = (float)cfg_.eye_width;
+        p.angle = cfg_.tilt_deg;
+
+        // listening: perk up - taller, a bit higher, slightly wider apart, pulse
+        p.length += perk_ * (28.f + 6.f * sinf(t * 5.f));
+        p.dy -= perk_ * 14.f;
+        p.dx += perk_ * side * 6.f;
+        p.width += perk_ * 6.f;
+
+        // thinking: look up-right, eyes alternately squish, gentle sway
+        {
+            float phase = t * 3.2f + (i == 0 ? 0.f : 1.7f);
+            p.dx += think_ * (28.f + 8.f * sinf(t * 1.3f));
+            p.dy += think_ * (-26.f);
+            p.length += think_ * (-30.f + 22.f * sinf(phase));
+            p.angle += think_ * 6.f * sinf(t * 1.3f);
+        }
+
+        // speaking: bounce with level
+        {
+            float bounce = audio_level_;
+            p.dy -= bounce * 22.f;
+            p.length += bounce * 36.f - 10.f * (state_ == FaceState::kSpeaking ? 1.f : 0.f) * (1 - bounce);
+            p.width += bounce * 6.f;
+        }
+
+        // blink: squash to a flat, almost horizontal bar
+        float closed = blink > sleep_ ? blink : sleep_;
+        if (closed > 0.001f) {
+            p.length = lerp(p.length, 46.f, closed);
+            p.width = lerp(p.width, 16.f, closed);
+            p.angle = lerp(p.angle, 90.f - side * 4.f, closed);
+            p.dy += closed * 22.f;
+        }
+        // sleep: slow droop
+        p.dy += sleep_ * (12.f + 5.f * sinf(t * 0.9f));
+
+        ApplyEye(i, p);
+    }
+
+    // sleeping "z z z" drifting up
+    if (sleep_ > 0.6f) {
+        float zt = fmodf(t, 3.0f) / 3.0f;
+        lv_obj_remove_flag(zzz_, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_set_pos(zzz_, w_ / 2 + cfg_.eye_spacing / 2 + 30 + (int)(zt * 20), h_ / 2 - 70 - (int)(zt * 60));
+        lv_obj_set_style_opa(zzz_, (lv_opa_t)(255 * (1 - zt) * clampf((sleep_ - 0.6f) * 2.5f, 0, 1)), 0);
+    } else {
+        lv_obj_add_flag(zzz_, LV_OBJ_FLAG_HIDDEN);
+    }
+    (void)since;
+}
diff -ruN '--exclude=out' a/main/tamagroki/grok_face.h b/main/tamagroki/grok_face.h
--- a/main/tamagroki/grok_face.h	1969-12-31 18:00:00.000000000 -0600
+++ b/main/tamagroki/grok_face.h	2026-10-15 16:16:08.159756022 -0500
@@ -0,0 +1,80 @@
+// Tamagroki cube face: purple background + two black tilted pill eyes.
+// Pure LVGL v9 code (no ESP-IDF deps) so the same file runs in the desktop
+// simulator (sim/face) and on the ESP32-S3.
+#pragma once
+#include <lvgl.h>
+#include <stdint.h>
+
+enum class FaceState : uint8_t {
+    kIdle = 0,
+    kListening,
+    kThinking,
+    kSpeaking,
+    kSleep,
+    kBusy,  // connecting / starting / activating (rendered like a slow "thinking")
+};
+
+const char* FaceStateName(FaceState s);
+
+struct FaceConfig {
+    uint32_t bg_color = 0x9B7FE0;   // solid background (RGB888)
+    uint32_t eye_color = 0x000000;  // pill eyes
+    float tilt_deg = 12.0f;         // lean of the pills from vertical (+ = top leans right)
+    int eye_spacing = 150;          // distance between eye centres (px @480)
+    int eye_length = 110;           // distance between the pill's cap centres
+    int eye_width = 84;             // pill thickness
+    int center_y_offset = -10;      // eyes slightly above centre
+};
+
+class GrokFace {
+public:
+    // Creates the face as a full-size child of `parent` (screen or lv_layer_top()).
+    void Create(lv_obj_t* parent, int width, int height, const FaceConfig& cfg);
+    void SetState(FaceState s, uint32_t now_ms);
+    FaceState state() const { return state_; }
+    // 0..1 loudness of the audio currently being played (speaking bounce).
+    void SetAudioLevel(float level) { audio_level_target_ = level < 0 ? 0 : (level > 1 ? 1 : level); }
+    // Small caption at the bottom (wifi setup, errors, optional subtitles). "" hides it.
+    void SetCaption(const char* text);
+    void SetBackground(uint32_t rgb);
+    // Advance the animation to absolute time now_ms. Call at ~30 Hz.
+    void Tick(uint32_t now_ms);
+    lv_obj_t* root() const { return root_; }
+
+private:
+    struct EyePose {
+        float dx, dy;    // offset from rest centre
+        float length;    // cap-centre distance
+        float width;     // thickness
+        float angle;     // degrees from vertical
+    };
+    void ApplyEye(int idx, const EyePose& p);
+    float Rand01();
+
+    FaceConfig cfg_;
+    lv_obj_t* root_ = nullptr;
+    lv_obj_t* eyes_[2] = {nullptr, nullptr};
+    lv_point_precise_t pts_[2][2];
+    lv_obj_t* caption_ = nullptr;
+    lv_obj_t* zzz_ = nullptr;
+    int w_ = 480, h_ = 480;
+
+    FaceState state_ = FaceState::kIdle;
+    uint32_t state_since_ = 0;
+    uint32_t last_tick_ = 0;
+    uint32_t rng_ = 0x1234567u;
+
+    // idle behaviour
+    uint32_t next_blink_ = 2500;
+    uint32_t blink_start_ = 0;
+    bool double_blink_ = false;
+    uint32_t next_glance_ = 4000;
+    float glance_target_x_ = 0, glance_target_y_ = 0;
+    float glance_x_ = 0, glance_y_ = 0;
+
+    // smoothed values
+    float audio_level_target_ = 0, audio_level_ = 0;
+    float perk_ = 0;   // 0..1 listening perk
+    float sleep_ = 0;  // 0..1 eyes closed for sleep
+    float think_ = 0;  // 0..1 thinking pose
+};
diff -ruN '--exclude=out' a/main/tamagroki/grok_face_display.cc b/main/tamagroki/grok_face_display.cc
--- a/main/tamagroki/grok_face_display.cc	1969-12-31 18:00:00.000000000 -0600
+++ b/main/tamagroki/grok_face_display.cc	2026-10-15 16:16:08.155756022 -0500
@@ -0,0 +1,134 @@
+#include "grok_face_display.h"
+#include "tamagroki.h"
+#include "application.h"
+#include "device_state.h"
+
+#include <esp_log.h>
+#include <string.h>
+
+#define TAG "GrokFace"
+
+#ifndef CONFIG_TAMAGROKI_BG_COLOR
+#define CONFIG_TAMAGROKI_BG_COLOR 0x9B7FE0
+#endif
+#ifndef CONFIG_TAMAGROKI_EYE_TILT_DEG
+#define CONFIG_TAMAGROKI_EYE_TILT_DEG 12
+#endif
+
+GrokFaceDisplay::~GrokFaceDisplay() {
+    if (timer_) lv_timer_delete(timer_);
+}
+
+void GrokFaceDisplay::SetupUI() {
+    // Let the stock UI build its objects (other code paths touch them),
+    // then cover everything with the face on the top layer.
+    SpiLcdDisplay::SetupUI();
+    DisplayLockGuard lock(this);
+    FaceConfig cfg;
+    cfg.bg_color = CONFIG_TAMAGROKI_BG_COLOR;
+    cfg.tilt_deg = (float)CONFIG_TAMAGROKI_EYE_TILT_DEG;
+    int scale_w = width_;
+    cfg.eye_spacing = cfg.eye_spacing * scale_w / 480;
+    cfg.eye_length = cfg.eye_length * scale_w / 480;
+    cfg.eye_width = cfg.eye_width * scale_w / 480;
+    face_.Create(lv_layer_top(), width_, height_, cfg);
+    lv_obj_set_style_bg_color(lv_screen_active(), lv_color_hex(CONFIG_TAMAGROKI_BG_COLOR), 0);
+    timer_ = lv_timer_create(TimerCb, 33, this);
+    ESP_LOGI(TAG, "Tamagroki face ready (bg #%06X, tilt %d)", (unsigned)CONFIG_TAMAGROKI_BG_COLOR,
+             CONFIG_TAMAGROKI_EYE_TILT_DEG);
+}
+
+void GrokFaceDisplay::TimerCb(lv_timer_t* t) {
+    static_cast<GrokFaceDisplay*>(lv_timer_get_user_data(t))->OnTick();
+}
+
+void GrokFaceDisplay::OnTick() {
+    // Runs inside the LVGL task with the LVGL lock held.
+    uint32_t now = lv_tick_get();
+    int ds = (int)Application::GetInstance().GetDeviceState();
+    if (ds != last_device_state_) {
+        thinking_hint_ = false;
+        last_device_state_ = ds;
+    }
+    FaceState fs;
+    switch ((DeviceState)ds) {
+        case kDeviceStateListening: fs = thinking_hint_ ? FaceState::kThinking : FaceState::kListening; break;
+        case kDeviceStateSpeaking: fs = FaceState::kSpeaking; break;
+        case kDeviceStateConnecting:
+        case kDeviceStateStarting:
+        case kDeviceStateActivating:
+        case kDeviceStateUpgrading: fs = FaceState::kBusy; break;
+        // Idle = no conversation open (wake word armed, not streaming the mic):
+        // always show the sleeping face, so awake eyes reliably mean "listening".
+        // The channel-closed path (relay close, idle close, network drop, BOOT stop)
+        // always lands in idle, so this does not depend on the relay.
+        case kDeviceStateIdle: fs = FaceState::kSleep; break;
+        default: fs = power_save_ ? FaceState::kSleep : FaceState::kIdle; break;
+    }
+    face_.SetState(fs, now);
+    float lvl = tamagroki::g_playback_level.load(std::memory_order_relaxed);
+    face_.SetAudioLevel(lvl);
+    // decay so the bounce settles when playback pauses (the audio task refreshes it per frame)
+    tamagroki::g_playback_level.store(lvl * 0.8f, std::memory_order_relaxed);
+    if (notification_until_ && (int32_t)(now - notification_until_) > 0) {
+        notification_until_ = 0;
+        face_.SetCaption(system_caption_.c_str());
+    }
+    face_.Tick(now);
+}
+
+void GrokFaceDisplay::SetEmotion(const char* emotion) {
+    if (emotion == nullptr) return;
+    DisplayLockGuard lock(this);
+    // The relay sends {"type":"llm","emotion":"thinking"} while the model works.
+    if (strcmp(emotion, "thinking") == 0) thinking_hint_ = true;
+    else if (strcmp(emotion, "neutral") == 0 || strcmp(emotion, "listening") == 0) thinking_hint_ = false;
+    else if (strcmp(emotion, "sleepy") == 0) power_save_ = true;
+}
+
+void GrokFaceDisplay::SetChatMessage(const char* role, const char* content) {
+    if (role == nullptr) return;
+    DisplayLockGuard lock(this);
+    if (strcmp(role, "system") == 0) {
+        // Wi-Fi provisioning instructions, activation codes, errors: always show.
+        system_caption_ = content ? content : "";
+        if (!notification_until_) face_.SetCaption(system_caption_.c_str());
+        return;
+    }
+#if CONFIG_TAMAGROKI_SHOW_SUBTITLES
+    face_.SetCaption(content ? content : "");
+#endif
+}
+
+void GrokFaceDisplay::ClearChatMessages() {
+    DisplayLockGuard lock(this);
+    system_caption_.clear();
+    face_.SetCaption("");
+}
+
+void GrokFaceDisplay::SetStatus(const char* status) {
+    // Status text (standby/listening/...) is expressed by the eyes instead.
+    (void)status;
+}
+
+void GrokFaceDisplay::ShowNotification(const char* notification, int duration_ms) {
+    if (notification == nullptr) return;
+    DisplayLockGuard lock(this);
+    face_.SetCaption(notification);
+    notification_until_ = lv_tick_get() + (uint32_t)duration_ms;
+    if (notification_until_ == 0) notification_until_ = 1;
+}
+
+void GrokFaceDisplay::ShowNotification(const std::string& notification, int duration_ms) {
+    ShowNotification(notification.c_str(), duration_ms);
+}
+
+void GrokFaceDisplay::SetPowerSaveMode(bool on) {
+    DisplayLockGuard lock(this);
+    power_save_ = on;
+}
+
+void GrokFaceDisplay::Nudge() {
+    DisplayLockGuard lock(this);
+    power_save_ = false;
+}
