+++ b/build.sh	2026-10-15 16:16:08.119756022 -0500
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# Build the Tamagroki cube firmware (ESP-IDF >= 6.0.1, 6.1 recommended).
+#   ./build.sh                       # uses tamagroki/sdkconfig.tamagroki
+#   TAMAGROKI_RELAY_URL=http://<relay-ip>:8765/xiaozhi/ota/ ./build.sh
+#   TAMAGROKI_COLOR=0xFF8800 TAMAGROKI_NAME=Jarvis TAMAGROKI_WAKE="hey jarvis" ./build.sh
+set -euo pipefail
+cd "$(dirname "$0")"
+if ! command -v idf.py >/dev/null; then
+  for p in "${IDF_PATH:-}" "$HOME/esp/esp-idf" "$HOME/.espressif/esp-idf"; do
+    [ -n "$p" ] && [ -f "$p/export.sh" ] && { . "$p/export.sh" >/dev/null; break; }
+  done
+fi
+command -v idf.py >/dev/null || { echo "ESP-IDF not found: install it (see README) or source export.sh"; exit 1; }
+
+frag=build/tamagroki.local.sdkconfig
+mkdir -p build
+cp tamagroki/sdkconfig.tamagroki "$frag"
+[ -n "${TAMAGROKI_RELAY_URL:-}" ] && echo "CONFIG_OTA_URL=\"$TAMAGROKI_RELAY_URL\"" >> "$frag"
+[ -n "${TAMAGROKI_COLOR:-}" ]     && echo "CONFIG_TAMAGROKI_BG_COLOR=$TAMAGROKI_COLOR" >> "$frag"
+[ -n "${TAMAGROKI_NAME:-}" ]      && echo "CONFIG_TAMAGROKI_NAME=\"$TAMAGROKI_NAME\"" >> "$frag"
+if [ -n "${TAMAGROKI_WAKE:-}" ]; then
+  echo "CONFIG_CUSTOM_WAKE_WORD=\"$(echo "$TAMAGROKI_WAKE" | tr 'A-Z' 'a-z')\"" >> "$frag"
+  echo "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"$TAMAGROKI_WAKE\"" >> "$frag"
+fi
+[ -f tamagroki/sdkconfig.local ] && cat tamagroki/sdkconfig.local >> "$frag"   # your private overrides (gitignored)
+
+# regenerate sdkconfig from defaults whenever the preset changed (full rebuild), else incremental
+if ! cmp -s "$frag" build/tamagroki.last.sdkconfig; then rm -f sdkconfig; fi
+cp "$frag" build/tamagroki.last.sdkconfig
+idf.py -DIDF_TARGET=esp32s3 "-DSDKCONFIG_DEFAULTS=sdkconfig.defaults;$frag" \
+       -DBOARD_NAME=esp32-s3-touch-amoled-2.16 build
+idf.py merge-bin
+echo "OK: build/merged-binary.bin ($(du -h build/merged-binary.bin | cut -f1))"
diff -ruN '--exclude=out' a/flash.sh b/flash.sh
--- a/flash.sh	1969-12-31 18:00:00.000000000 -0600
+++ b/flash.sh	2026-10-15 16:16:08.119756022 -0500
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+# One-command build + flash for the Tamagroki cube (Waveshare ESP32-S3-Touch-AMOLED-2.16).
+#
+#   ./flash.sh /dev/cu.usbmodem*            # build for this Mac's relay, flash, open monitor
+#   ./flash.sh /dev/cu.usbmodem* --no-build # flash the existing build/merged-binary.bin with esptool
+#   TAMAGROKI_RELAY_URL=http://<relay-ip>:8765/xiaozhi/ota/ ./flash.sh /dev/cu.usbmodem1101
+#   NO_MONITOR=1 ./flash.sh /dev/cu.usbmodem1101
+set -euo pipefail
+cd "$(dirname "$0")"
+PORT="${1:-}"
+[ -z "$PORT" ] && { ls /dev/cu.usbmodem* /dev/ttyACM* 2>/dev/null | head -1 >/dev/null; PORT=$(ls /dev/cu.usbmodem* /dev/ttyACM* 2>/dev/null | head -1 || true); }
+[ -z "$PORT" ] && { echo "usage: $0 /dev/cu.usbmodemXXXX [--no-build]   (plug the cube in over USB-C)"; exit 1; }
+shift || true
+BUILD=1; [ "${1:-}" = "--no-build" ] && BUILD=0
+
+if [ -z "${TAMAGROKI_RELAY_URL:-}" ]; then
+  if command -v scutil >/dev/null; then HOST="$(scutil --get LocalHostName).local"; else HOST="$(hostname).local"; fi
+  export TAMAGROKI_RELAY_URL="http://${HOST}:8765/xiaozhi/ota/"
+fi
+
+if [ "$BUILD" = 1 ]; then
+  echo ">> building with relay OTA URL $TAMAGROKI_RELAY_URL"
+  ./build.sh
+  echo ">> flashing $PORT"
+  idf.py -p "$PORT" -b 921600 flash   # keeps NVS (Wi-Fi credentials)
+  [ -z "${NO_MONITOR:-}" ] && exec idf.py -p "$PORT" monitor
+else
+  BIN=build/merged-binary.bin
+  [ -f "$BIN" ] || { echo "no $BIN; run without --no-build"; exit 1; }
+  ESPTOOL="esptool.py"; command -v esptool.py >/dev/null || ESPTOOL="python3 -m esptool"
+  echo ">> flashing $BIN to $PORT (whole flash image, this also resets saved Wi-Fi)"
+  $ESPTOOL --chip esp32s3 -p "$PORT" -b 921600 --before default-reset --after hard-reset write-flash 0x0 "$BIN"
+  echo "done. The relay URL baked into this binary is in build/tamagroki.local.sdkconfig (CONFIG_OTA_URL);"
+  echo "you can also change it in the Wi-Fi setup page (Advanced -> OTA URL)."
+fi
