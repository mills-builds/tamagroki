diff -ruN '--exclude=out' a/sim/face/main.cc b/sim/face/main.cc
--- a/sim/face/main.cc	1969-12-31 18:00:00.000000000 -0600
+++ b/sim/face/main.cc	2026-10-15 16:16:08.119756022 -0500
@@ -0,0 +1,80 @@
+// Headless LVGL simulator for the Tamagroki face. Renders each animation state
+// to PPM frames (converted to PNG/GIF by render.py). No SDL needed.
+#include <lvgl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <string>
+#include <vector>
+#include <math.h>
+#include "grok_face.h"
+
+static const int W = 480, H = 480;
+static std::vector<uint8_t> fb(W * H * 4);
+static uint32_t g_now = 0;
+static uint32_t tick_cb() { return g_now; }
+
+static void flush_cb(lv_display_t* d, const lv_area_t* a, uint8_t* px) {
+    int w = lv_area_get_width(a);
+    for (int y = a->y1; y <= a->y2; y++)
+        memcpy(&fb[(y * W + a->x1) * 4], px + (y - a->y1) * w * 4, w * 4);
+    lv_display_flush_ready(d);
+}
+
+static void save_ppm(const std::string& path) {
+    FILE* f = fopen(path.c_str(), "wb");
+    fprintf(f, "P6\n%d %d\n255\n", W, H);
+    for (int i = 0; i < W * H; i++) { // XRGB8888 little-endian: B G R A
+        uint8_t rgb[3] = {fb[i * 4 + 2], fb[i * 4 + 1], fb[i * 4 + 0]};
+        fwrite(rgb, 1, 3, f);
+    }
+    fclose(f);
+}
+
+int main(int argc, char** argv) {
+    const char* out = argc > 1 ? argv[1] : "out";
+    uint32_t bg = argc > 2 ? strtoul(argv[2], nullptr, 16) : 0x9B7FE0;
+    lv_init();
+    lv_tick_set_cb(tick_cb);
+    lv_display_t* disp = lv_display_create(W, H);
+    static std::vector<uint8_t> buf(W * H * 4);
+    lv_display_set_buffers(disp, buf.data(), nullptr, buf.size(), LV_DISPLAY_RENDER_MODE_PARTIAL);
+    lv_display_set_flush_cb(disp, flush_cb);
+
+    FaceConfig cfg;
+    cfg.bg_color = bg;
+    GrokFace face;
+    face.Create(lv_screen_active(), W, H, cfg);
+
+    struct Seg { FaceState s; int ms; };
+    // a scripted "conversation" timeline
+    std::vector<Seg> script = {
+        {FaceState::kIdle, 7000}, {FaceState::kListening, 2500}, {FaceState::kThinking, 2500},
+        {FaceState::kSpeaking, 4000}, {FaceState::kIdle, 1500}, {FaceState::kSleep, 4000},
+    };
+    const int frame_ms = 40;  // 25 fps
+    int frame = 0;
+    char path[512];
+    FILE* index = fopen((std::string(out) + "/frames.csv").c_str(), "w");
+    for (auto& seg : script) {
+        face.SetState(seg.s, g_now);
+        for (int t = 0; t < seg.ms; t += frame_ms, g_now += frame_ms) {
+            if (seg.s == FaceState::kSpeaking) {
+                // fake syllable envelope ~ 4-6 Hz
+                float x = g_now / 1000.0f;
+                float lvl = fabsf(sinf(x * 13.f)) * (0.55f + 0.45f * sinf(x * 2.3f));
+                face.SetAudioLevel(lvl);
+            }
+            face.Tick(g_now);
+            lv_timer_handler();
+            lv_refr_now(disp);
+            snprintf(path, sizeof(path), "%s/f%05d.ppm", out, frame);
+            save_ppm(path);
+            fprintf(index, "%d,%s,%u\n", frame, FaceStateName(seg.s), g_now);
+            frame++;
+        }
+    }
+    fclose(index);
+    printf("rendered %d frames to %s\n", frame, out);
+    return 0;
+}
diff -ruN '--exclude=out' a/sim/face/render.py b/sim/face/render.py
--- a/sim/face/render.py	1969-12-31 18:00:00.000000000 -0600
+++ b/sim/face/render.py	2026-10-15 16:16:08.123756022 -0500
@@ -0,0 +1,44 @@
+#!/usr/bin/env python3
+"""Build + run the headless face simulator and produce PNG/GIF previews.
+Usage: python3 sim/face/render.py [--bg 9B7FE0] [--out sim/face/out]"""
+import argparse, csv, os, subprocess, sys, tempfile, glob
+from PIL import Image
+
+here = os.path.dirname(os.path.abspath(__file__))
+ap = argparse.ArgumentParser()
+ap.add_argument("--bg", default="9B7FE0")
+ap.add_argument("--out", default=os.path.join(here, "out"))
+ap.add_argument("--build", default="/tmp/grokface_simbuild")
+a = ap.parse_args()
+
+subprocess.check_call(["cmake", "-S", here, "-B", a.build, "-DCMAKE_BUILD_TYPE=Release"], stdout=subprocess.DEVNULL)
+subprocess.check_call(["cmake", "--build", a.build, "-j8"], stdout=subprocess.DEVNULL)
+os.makedirs(a.out, exist_ok=True)
+with tempfile.TemporaryDirectory() as tmp:
+    subprocess.check_call([os.path.join(a.build, "grokface_sim"), tmp, a.bg])
+    rows = list(csv.reader(open(os.path.join(tmp, "frames.csv"))))
+    by_state = {}
+    for fr, st, _ in rows:
+        by_state.setdefault(st, []).append(int(fr))
+    img = lambda i: Image.open(os.path.join(tmp, f"f{i:05d}.ppm")).convert("RGB")
+    stills = []
+    for st, frames in by_state.items():
+        blk = lambda i: sum(1 for p in img(i).resize((96, 96)).get_flattened_data() if p[0] < 40)
+        cand = frames[len(frames) // 3:]
+        pick = cand[-1] if st == "sleep" else max(cand[::3], key=blk)  # skip blink frames
+        im = img(pick); im.save(os.path.join(a.out, f"{st}.png")); stills.append((st, im))
+        seq = [img(i).resize((240, 240), Image.LANCZOS) for i in frames]
+        seq[0].save(os.path.join(a.out, f"{st}.gif"), save_all=True, append_images=seq[1:], duration=40, loop=0)
+    all_frames = [img(int(r[0])).resize((240, 240), Image.LANCZOS) for r in rows]
+    all_frames[0].save(os.path.join(a.out, "timeline.gif"), save_all=True, append_images=all_frames[1:], duration=40, loop=0)
+    # blink still: find the most-closed frame in idle by counting black pixels
+    idle = by_state["idle"]
+    blackest = min(idle, key=lambda i: sum(1 for p in img(i).resize((96, 96)).get_flattened_data() if p[0] < 40))
+    img(blackest).save(os.path.join(a.out, "idle_blink.png"))
+    sheet = Image.new("RGB", (240 * len(stills), 260), "white")
+    from PIL import ImageDraw
+    d = ImageDraw.Draw(sheet)
+    for k, (st, im) in enumerate(stills):
+        sheet.paste(im.resize((240, 240), Image.LANCZOS), (240 * k, 20)); d.text((240 * k + 8, 4), st, fill="black")
+    sheet.save(os.path.join(a.out, "contact_sheet.png"))
+print("wrote", sorted(os.path.basename(p) for p in glob.glob(os.path.join(a.out, "*"))))
