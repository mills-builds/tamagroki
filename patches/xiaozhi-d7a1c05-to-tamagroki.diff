+# Tamagroki cube build preset (Waveshare ESP32-S3-Touch-AMOLED-2.16)
+# Applied on top of sdkconfig.defaults + sdkconfig.defaults.esp32s3 by ./build.sh
+CONFIG_BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_2_16=y
+CONFIG_USE_WECHAT_MESSAGE_STYLE=n
+CONFIG_USE_DEVICE_AEC=y
+CONFIG_LANGUAGE_EN_US=y
+
+# --- Relay / server -------------------------------------------------------
+# The relay (relay/) serves the xiaozhi OTA endpoint and hands back its websocket URL.
+# build.sh overrides this from $TAMAGROKI_RELAY_URL (default: http://tamagroki-relay.local:8765/xiaozhi/ota/)
+CONFIG_OTA_URL="http://tamagroki-relay.local:8765/xiaozhi/ota/"
+
+# --- Wake word: "Yo Grok" via ESP-SR MultiNet custom command ----------------
+# ";"-separated phrases, all mapped to wake ("yo grog" catches a common mishearing)
+CONFIG_WAKE_WORD_DISABLED=n
+CONFIG_USE_ESP_WAKE_WORD=n
+CONFIG_USE_AFE_WAKE_WORD=n
+CONFIG_USE_CUSTOM_WAKE_WORD=y
+CONFIG_CUSTOM_WAKE_WORD="yo grok;yo grog;yoh grok;yo grawk"
+CONFIG_CUSTOM_WAKE_WORD_DISPLAY="Yo Grok"
+CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=13
+CONFIG_CUSTOM_WAKE_WORD_SW_GAIN=3
+CONFIG_SR_MN_EN_MULTINET7_QUANT=y
+CONFIG_SR_MN_CN_NONE=y
+# barge-in by wake word while the bot is talking
+CONFIG_WAKE_WORD_DETECTION_IN_LISTENING=y
+
+# --- Tamagroki face -----------------------------------------------------------
+CONFIG_TAMAGROKI_FACE=y
+CONFIG_TAMAGROKI_NAME="Tamagroki"
+CONFIG_TAMAGROKI_BG_COLOR=0x9B7FE0
+CONFIG_TAMAGROKI_EYE_TILT_DEG=12
+CONFIG_TAMAGROKI_SHOW_SUBTITLES=n
+CONFIG_TAMAGROKI_IMU_WAKE=n
+CONFIG_TAMAGROKI_IMU_THRESHOLD_MG=350
+CONFIG_LV_FONT_MONTSERRAT_24=y
