# Copy to relay/.env (gitignored) or export these in your shell.
# Paste your key from https://console.x.ai  -- never commit it.
XAI_API_KEY=
TAMAGROKI_NAME=Tamagroki
XAI_VOICE=eve
RELAY_PORT=8765
# Optional shared secret; the relay hands it to the device via the OTA response
RELAY_DEVICE_TOKEN=
# Go to sleep after this many seconds of quiet. The timer only runs while
# Tamagroki is waiting on you (not while you talk or while it is replying).
TAMAGROKI_IDLE_CLOSE_S=15
# Device speaker volume (0-100) set when the cube connects; 80 is the recommended cap
RELAY_DEVICE_VOLUME=80
# Gain on model audio sent to the cube, and on cube mic audio sent to xAI
RELAY_OUT_GAIN=1.5
RELAY_IN_GAIN=3
# Set to 0 to disable the xAI web_search tool
TAMAGROKI_WEB_SEARCH=1
